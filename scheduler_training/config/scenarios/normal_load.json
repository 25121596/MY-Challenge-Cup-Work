{
  "schema_version": "scheduler-experiment-scenario/1.0",
  "scenario_id": "normal_load",
  "description": "Steady typed workload with healthy edge, cloud and network resources.",
  "task_source": "typed_simulation",
  "training_weight": 0.4,
  "arrival": {
    "kind": "periodic_bernoulli",
    "slot_duration_s": 0.05,
    "period_s": 1.0,
    "segments": [
      {"start_s": 0.0, "end_s": 1.0, "probability": 0.1}
    ]
  },
  "resource": {
    "edge_initial": 0.8,
    "cloud_initial": 0.85
  },
  "network": {
    "initial_quality": 0.85,
    "initial_state": "GOOD",
    "good_quality": 0.9,
    "bad_quality": 0.45,
    "good_to_bad_per_s": 0.04,
    "bad_to_good_per_s": 0.5,
    "min_bandwidth_mbps": 20.0,
    "max_bandwidth_mbps": 50.0,
    "noise_std_per_s": 0.015
  },
  "service_time": {
    "edge_scale": 1.0,
    "cloud_scale": 1.0
  }
}
